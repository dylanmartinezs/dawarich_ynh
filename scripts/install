#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source /usr/share/yunohost/helpers

#=================================================
# INITIALIZE AND STORE SETTINGS
#=================================================

admin=$(ynh_user_get_info --username=$admin --key=username)
admin_mail=$(ynh_user_get_info --username=$admin --key=mail)

key=$(ynh_string_random --length=45 | base64)
ynh_app_setting_set --key=key --value=$key

secret_key_base=$(ynh_string_random --length=45 | base64)
ynh_app_setting_set --key=secret_key_base --value=$secret_key_base

redis_db=$(ynh_redis_get_free_db)
ynh_app_setting_set --key=redis_db --value=$redis_db

db_name=$app
db_user=$app
ynh_app_setting_set --app=$app --key=db_name --value=$db_name
ynh_app_setting_set --app=$app --key=db_user --value=$db_user

# Detect PG 17 port for DATABASE_PORT in .env
pg17_port=$(pg_lsclusters | grep "17.*main" | awk '{print $3}')
if [ -n "$pg17_port" ]; then
    ynh_app_setting_set --app=$app --key=pg_port --value=$pg17_port
else
    ynh_app_setting_set --app=$app --key=pg_port --value=5432
fi

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

ynh_setup_source --dest_dir="$install_dir"

chown -R "$app:www-data" "$install_dir"

#=================================================
# PREPARE A POSTGRESQL DATABASE
#=================================================
ynh_script_progression "Configuring the PostgreSQL database..."

# YunoHost's [resources.db] created the DB on the default cluster (port 5432).
# On fresh Trixie, that's PG 17 — nothing to do.
# On upgraded Bookworm→Trixie, that's PG 15 — need to migrate to PG 17.
pg_port=$(ynh_app_setting_get --app=$app --key=pg_port)

if [ "$pg_port" = "5432" ]; then
    # PG 17 is the default cluster — DB already created correctly by [resources.db]
    ynh_app_setting_set --app=$app --key=pg_port --value=5432

    # Fix collation version mismatch after major Debian upgrade
    ynh_psql_db_shell <<< "ALTER DATABASE template1 REFRESH COLLATION VERSION;" 2>/dev/null || true
    ynh_psql_db_shell <<< "ALTER DATABASE postgres REFRESH COLLATION VERSION;" 2>/dev/null || true

    # Create PostGIS extension
    ynh_psql_db_shell <<< "ALTER USER $db_user WITH SUPERUSER;"
    ynh_psql_db_shell <<< "CREATE EXTENSION IF NOT EXISTS postgis;"
    ynh_psql_db_shell <<< "ALTER USER $db_user WITH NOSUPERUSER;"

else
    # PG 15 is on port 5432, PG 17 on $pg17_port — migrate the DB
    db_pwd=$(ynh_app_setting_get --app=$app --key=db_pwd)
    ynh_app_setting_set --app=$app --key=pg_port --value=$pg17_port

    # Fix collation version mismatch on PG 17
    sudo -u postgres psql -p $pg17_port -c "ALTER DATABASE template1 REFRESH COLLATION VERSION;" 2>/dev/null || true
    sudo -u postgres psql -p $pg17_port -c "ALTER DATABASE postgres REFRESH COLLATION VERSION;" 2>/dev/null || true

    # Migrate: dump from PG 15, recreate on PG 17
    sudo -u postgres pg_dump -p 5432 $db_name > /tmp/${db_name}_dump.sql 2>/dev/null || true
    sudo -u postgres psql -p 5432 -c "DROP DATABASE $db_name;"
    sudo -u postgres psql -p 5432 -c "DROP USER $db_user;"
    sudo -u postgres psql -p $pg17_port -c "DROP DATABASE IF EXISTS $db_name;" 2>/dev/null || true
    sudo -u postgres psql -p $pg17_port -c "DROP USER IF EXISTS $db_user;" 2>/dev/null || true
    sudo -u postgres psql -p $pg17_port -c "CREATE USER $db_user WITH PASSWORD '$db_pwd';"
    sudo -u postgres psql -p $pg17_port -c "CREATE DATABASE $db_name OWNER $db_user;"
    if [ -s /tmp/${db_name}_dump.sql ]; then
        sudo -u postgres psql -p $pg17_port -d $db_name < /tmp/${db_name}_dump.sql 2>/dev/null || true
        sudo rm -f /tmp/${db_name}_dump.sql
    fi

    # Create PostGIS extension on PG 17
    sudo -u postgres psql -p $pg17_port -c "ALTER USER $db_user WITH SUPERUSER;"
    sudo -u postgres psql -p $pg17_port -c "CREATE EXTENSION IF NOT EXISTS postgis;" $db_name
    sudo -u postgres psql -p $pg17_port -c "ALTER USER $db_user WITH NOSUPERUSER;"
fi

#=================================================
# APP INITIAL CONFIGURATION
#=================================================
ynh_script_progression "Adding $app's configuration files..."

ynh_config_add --template=".env" --destination="$install_dir/.env"

chmod 400 "$install_dir/.env"
chown "$app:$app" "$install_dir/.env"

#=================================================
# BUILD APP
#=================================================
ynh_script_progression "Building $app..."

pushd "$install_dir"
    env corepack enable
    ynh_hide_warnings ynh_exec_as_app yarn install --immutable
    gem update --system --no-document
	gem install bundler --no-document
    ynh_exec_as_app LD_PRELOAD=libjemalloc.so bundle config set --local path 'vendor/bundle'
    ynh_exec_as_app LD_PRELOAD=libjemalloc.so bundle config set --local without 'development test'
    ynh_exec_as_app LD_PRELOAD=libjemalloc.so bundle install --jobs 4 --retry 3

    set -o allexport
    source "$install_dir/.env"
    set +o allexport

    #ynh_hide_warnings ynh_exec_as_app env $(cat $install_dir/.env | xargs) LD_PRELOAD=libjemalloc.so bundle exec $install_dir/bin/rails credentials:edit 

    ynh_hide_warnings ynh_exec_as_app env $(cat $install_dir/.env | xargs) LD_PRELOAD=libjemalloc.so bundle exec rails db:migrate
    ynh_hide_warnings ynh_exec_as_app env $(cat $install_dir/.env | xargs) LD_PRELOAD=libjemalloc.so bundle exec rails dawarich:backfill_place_names
    ynh_hide_warnings ynh_exec_as_app env $(cat $install_dir/.env | xargs) LD_PRELOAD=libjemalloc.so bundle exec rails dawarich:cleanup_suggested_places
    ynh_hide_warnings ynh_exec_as_app env $(cat $install_dir/.env | xargs) LD_PRELOAD=libjemalloc.so bundle exec rake data:migrate
    sed -i "s/RGeo::Geos.factory(srid: 4326)/RGeo::Geos.factory(srid: 4326, uses_lenient_multi_polygon_assertions: true)/" $install_dir/db/seeds.rb
    ynh_hide_warnings ynh_exec_as_app env $(cat $install_dir/.env | xargs) LD_PRELOAD=libjemalloc.so bundle exec rails db:seed
    ynh_hide_warnings ynh_exec_as_app env $(cat $install_dir/.env | xargs) LD_PRELOAD=libjemalloc.so bundle exec rake assets:precompile

    ynh_safe_rm vendor/bundle/ruby/$ruby_version/cache/*.gem
popd 

ynh_script_progression "Creating user..."

#Create new admin user and delete default one
pushd "$install_dir"
    ynh_hide_warnings ynh_exec_as_app env $(cat $install_dir/.env | xargs) LD_PRELOAD=libjemalloc.so bundle exec rails runner "User.create!(email: '$admin_mail', password: '$password', admin: true)"
    ynh_hide_warnings ynh_exec_as_app env $(cat $install_dir/.env | xargs) LD_PRELOAD=libjemalloc.so bundle exec rails runner "User.find_by(email: 'demo@dawarich.app')&.destroy"
popd

#Remove unneeded files
ynh_safe_rm "$install_dir"/.cache
ynh_safe_rm "$install_dir"/node_modules
ynh_safe_rm "$install_dir"/.github
ynh_safe_rm "$install_dir"/.devcontainer
ynh_safe_rm "$install_dir"/.circleci
ynh_safe_rm "$install_dir"/docs
ynh_safe_rm "$install_dir"/test
ynh_safe_rm "$install_dir"/spec
ynh_safe_rm "$install_dir"/screenshots

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

# Ensure the nginx app config directory exists
mkdir -p "/etc/nginx/conf.d/$domain.d/"

# Use logrotate to manage application logfiles
ynh_config_add_logrotate
mkdir -p /var/log/$app
touch /var/log/$app/$app.log
touch /var/log/$app/$app-sidekig.log
chown $app:$app /var/log/$app

ynh_config_add_nginx

ynh_config_add_systemd --service="${app}" --template="dawarich.service"
ynh_config_add_systemd --service="${app}-sidekiq" --template="dawarich-sidekiq.service"

yunohost service add "$app" --description="$app’s service" --log="/var/log/$app/$app.log"
yunohost service add "$app-sidekiq" --description="$app sidekiq service" --log="/var/log/$app/$app-sidekiq.log"

# Create a dedicated Fail2Ban config
#ynh_config_add_fail2ban --logpath="/var/log/nginx/${domain}-error.log" --failregex="Regex to match into the log for a failed login"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start" --log_path=/var/log/$app/$app.log --wait_until="Listening on"
ynh_systemctl --service=${app}-sidekiq --action="start" --log_path=/var/log/$app/$app-sidekiq.log --wait_until="Firing startup event"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
